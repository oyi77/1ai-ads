#!/usr/bin/env python3
"""Extract structured patrol data from Meta API"""
import json

with open('/tmp/meta_insights.json') as f:
    meta_data = json.load(f)

with open('/home/openclaw/projects/1ai-ads/data/brain/shopee_master_brain_2026-06-09.json') as f:
    shopee_data = json.load(f)

with open('/home/openclaw/projects/1ai-ads/data/brain/0858_campaigns_fetch.json') as f:
    fetch_data = json.load(f)

# --- Meta active campaigns ---
active_campaigns = meta_data.get('data', [])
total_spend = 0
total_impressions = 0
total_clicks = 0

campaign_details = []
for c in active_campaigns:
    name = c.get('name', '')
    status = c.get('status', '')
    budget_raw = c.get('daily_budget', '0')
    budget = int(budget_raw) if budget_raw else 0
    
    ins_list = c.get('insights', {}).get('data', [])
    if ins_list:
        ins = ins_list[0]
        spend = int(float(ins.get('spend', 0)))
        impressions = int(float(ins.get('impressions', 0)))
        clicks = int(float(ins.get('clicks', 0)))
        ctr = float(ins.get('ctr', 0))
        cpc = float(ins.get('cpc', 0))
        total_spend += spend
        total_impressions += impressions
        total_clicks += clicks
    else:
        spend = 0
        impressions = 0
        clicks = 0
        ctr = 0
        cpc = 0
    
    # Extract taglink from name
    taglink = 'unknown'
    for tl in ['rakpiringpengering', 'organizerpullout', 'setelanbajukaosmihugajah', 'setelangajahthaialand', 'gajahThailand', 'lemarirakdapur', 'rakdapur']:
        if tl in name.lower():
            taglink = tl
            break
    
    campaign_details.append({
        'id': c['id'],
        'name': name,
        'status': status,
        'budget': budget,
        'spend_7d': spend,
        'impressions_7d': impressions,
        'clicks_7d': clicks,
        'ctr_7d': ctr,
        'cpc_7d': cpc,
        'taglink': taglink
    })

# --- Shopee data for taglinks ---
commission_data = shopee_data.get('commission_data_completed', {})
click_data_0858 = shopee_data.get('click_data', {}).get('0858/Kakriput', {})

taglink_health = {}
for tl, info in commission_data.items():
    if tl not in ['rakpiringpengering', 'organizerpullout', 'setelanbajukaosmihugajah', 'setelangajahthaialand']:
        continue
    clicks = click_data_0858.get(tl, 0)
    completed_orders = info.get('completed_orders', 0)
    completed_commission = info.get('completed_commission', 0)
    pending_commission = info.get('pending_commission', 0)
    
    # CVR from last 7 days shopee data
    if tl == 'rakpiringpengering':
        cvr_7d = 26.32
        pending_orders_7d = 55
    elif tl == 'organizerpullout':
        cvr_7d = 57.58
        pending_orders_7d = 38
    elif tl == 'setelanbajukaosmihugajah':
        cvr_7d = 7.14
        pending_orders_7d = 62
    elif tl == 'setelangajahthaialand':
        cvr_7d = 5.46
        pending_orders_7d = 157
    else:
        cvr_7d = 0
        pending_orders_7d = 0
    
    taglink_health[tl] = {
        'clicks_lifetime': clicks,
        'completed_orders': completed_orders,
        'completed_commission': completed_commission,
        'pending_commission': pending_commission,
        'cvr_7d_pct': cvr_7d,
        'pending_orders_7d': pending_orders_7d
    }

# --- OFF_ campaigns analysis ---
off_candidates = []
for cand in fetch_data.get('candidates', []):
    name = cand.get('name', '')
    if name.startswith('OFF_'):
        off_candidates.append(cand)

# Determine which OFF_ could be turned ON based on taglink health
for cand in off_candidates:
    tl = cand.get('taglink', '')
    if tl in taglink_health:
        health = taglink_health[tl]
        cand['cvr_7d'] = health['cvr_7d_pct']
        cand['pending_commission'] = health['pending_commission']
        cand['has_completed_orders'] = health['completed_orders'] > 0
        cand['recommended_action'] = 'CAN_ON' if health['cvr_7d_pct'] > 5 or health['pending_commission'] > 50000 or health['completed_orders'] > 0 else 'STAY_OFF'
    else:
        cand['recommended_action'] = 'UNKNOWN_TAGLINK'

# --- OFF_ campaigns grouped by taglink ---
off_by_taglink = {}
for cand in off_candidates:
    tl = cand.get('taglink', 'unknown')
    if tl not in off_by_taglink:
        off_by_taglink[tl] = []
    off_by_taglink[tl].append(cand)

output = {
    'patrol_timestamp': '2026-06-09',
    'account': 'act_435670549443081',
    'total_active_campaigns': len(active_campaigns),
    'total_7d_spend': total_spend,
    'total_7d_impressions': total_impressions,
    'total_7d_clicks': total_clicks,
    'taglink_health': taglink_health,
    'off_candidates_count': len(off_candidates),
    'off_candidates_by_taglink': {tl: len(cands) for tl, cands in off_by_taglink.items()},
    'campaign_details': campaign_details
}

with open('/tmp/patrol_output.json', 'w') as f:
    json.dump(output, f, indent=2)

print(json.dumps(output, indent=2))

{
  "$schema": "https://hermes-agent.nousresearch.com/config.schema.json",
  "version": "1.0",
  "soul": ".hermes/SOUL.md",
  "context": [
    ".hermes/context/architecture.md",
    ".hermes/context/patterns.md",
    ".hermes/context/guardrails.md"
  ],
  "skills": [
    ".hermes/skills/meta-ads-engine.md",
    ".hermes/skills/server-layered-arch.md",
    ".hermes/skills/mcp-integration.md"
  ],
  "mcp": {
    "1ai-hub": {
      "type": "remote",
      "url": "http://localhost:9099/mcp",
      "enabled": true
    },
    "cf-router": {
      "type": "local",
      "command": ["/home/openclaw/.local/bin/cloudflare-router", "mcp"],
      "enabled": true
    }
  },
  "guardrails": {
    "enforce_during_development": true,
    "enforce_at_commit": true,
    "block_patterns": {
      "direct_meta_api": {
        "pattern": "import requests.*graph\\.facebook\\.com|requests\\.get\\(['\"]https://graph\\.facebook\\.com",
        "severity": "error",
        "message": "Direct Meta API calls forbidden. Use vilona_trakpro_engine helpers."
      },
      "duplicate_token_loading": {
        "pattern": "os\\.getenv\\(['\"]META_ACCESS_TOKEN['\"]\\)",
        "severity": "error",
        "message": "Token loading duplicated. Import ACCESS_TOKEN from vilona_trakpro_engine."
      },
      "hardcoded_paths": {
        "pattern": "/home/openclaw/",
        "severity": "error",
        "message": "Hardcoded paths forbidden. Use WORKSPACE/DATA_DIR from engine."
      },
      "console_log_in_prod": {
        "pattern": "console\\.log\\(.*\\)",
        "severity": "warning",
        "message": "Use logger from server/lib/logger.js instead of console.log."
      },
      "raw_sql_in_routes": {
        "pattern": "(routes|services)/.*\\.js.*db\\.prepare",
        "severity": "error",
        "message": "Raw SQL in routes/services forbidden. Use repositories."
      },
      "throwaway_test_scripts": {
        "pattern": "scripts/test_.*\\.py",
        "severity": "error",
        "message": "Test scripts belong in tests/ with Vitest/Playwright."
      }
    },
    "required_patterns": {
      "parameterized_queries": {
        "pattern": "db\\.prepare\\(['\"`].*\\?.*['\"`]\\)",
        "severity": "info",
        "message": "Use parameterized queries (?, ?, ?)"
      },
      "typed_errors": {
        "pattern": "throw new (ApiError|NotFoundError|ValidationError|UnauthorizedError)",
        "severity": "info",
        "message": "Use typed errors from server/lib/errors.js"
      },
      "engine_imports": {
        "pattern": "from vilona_trakpro_engine import",
        "severity": "info",
        "message": "Good: Importing from engine (single source of truth)"
      }
    }
  },
  "file_placement": {
    "routes": "server/routes/",
    "services": "server/services/",
    "repositories": "server/repositories/",
    "utilities": "server/lib/",
    "middleware": "server/middleware/",
    "scripts": "scripts/",
    "tests": "tests/",
    "state": "data/",
    "config": "server/config/",
    "forbidden_in_root": ["*.js", "*.ts", "*.py", "*.sql"]
  },
  "hooks": {
    "pre_write": ".hermes/hooks/pre-write.sh",
    "description": "Blocks forbidden patterns before file writes. Exit 1 = block."
  },
  "behavior": {
    "ask_when_ambiguous": true,
    "check_existing_patterns_first": true,
    "use_lsp_diagnostics": true,
    "run_tests_before_commit": true,
    "atomic_commits": true,
    "verify_implementation": true
  }
}
# Offsite backup target — copy to backup.env and fill ONE block.
# This file is gitignored; never commit real credentials.

# ── Option 1: restic (recommended) ───────────────────────────────
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/my-bucket/1ai-ads
# RESTIC_PASSWORD=change-me
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# # or Backblaze B2:
# # RESTIC_REPOSITORY=b2:bucket-name:1ai-ads
# # B2_ACCOUNT_ID=...
# # B2_ACCOUNT_KEY=...

# ── Option 2: rclone remote ──────────────────────────────────────
# BACKUP_RCLONE_REMOTE=b2:my-bucket/1ai-ads
# BACKUP_RCLONE_REMOTE=s3:my-bucket/1ai-ads

# ── Option 3: plain directory (mounted NAS / external disk) ──────
# BACKUP_OFFSITE_DIR=/mnt/nas/1ai-ads

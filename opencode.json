{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/auto/best-reasoning",
  "mcp": {
    "1ai-hub": {
      "type": "remote",
      "url": "http://localhost:9099/mcp",
      "enabled": true
    },
    "cf-router": {
      "type": "local",
      "command": ["/home/openclaw/.local/bin/cloudflare-router", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "edit": {
      "scripts/test_*.py": "deny",
      "*.log": "deny",
      "data/*.json": "deny"
    },
    "external_directory": {
      "/home/openclaw/*": "deny"
    }
  },
  "provider": {
    "bk-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BK AI",
      "options": {
        "baseURL": "http://100.123.92.72:20128/v1",
        "apiKey": "sk-f0c1ddf471008e76-f92ijk-07d16379"
      },
      "models": {
        "auto": { "name": "Auto (OmniRoute)" },
        "best-chat": { "name": "Best Chat" },
        "best-coding": { "name": "Best Coding" },
        "best-fast": { "name": "Best Fast" },
        "best-reasoning": { "name": "Best Reasoning" }
      }
    }
  },
  "hooks": {
    "pre_write": [
      "bash .hermes/hooks/pre-write.sh \"$FILE\""
    ],
    "post_write": [
      "bash -c 'if [[ \"$FILE\" =~ \\.(js|ts)$ ]]; then npx eslint \"$FILE\" --quiet; fi'"
    ]
  }
}
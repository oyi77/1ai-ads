# Server
PORT=5000
NODE_ENV=development
DB_PATH=./db/adforge.db
LOG_LEVEL=info

# Security (REQUIRED)
JWT_SECRET=           # REQUIRED - no default, server will not start without it
ENCRYPTION_KEY=     # REQUIRED - 64-char hex string (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORS_ORIGIN=http://localhost:5173

# LLM / AI
OMNIROUTE_URL=http://localhost:20128/v1/chat/completions
OMNIROUTE_MODEL=auto/pro-fast
OMNIROUTE_API_KEY=
LLM_TIMEOUT=30000

# Ad Platform APIs
META_ACCESS_TOKEN=
FB_SYSTEM_TOKEN=
GOOGLE_ADS_CREDENTIALS_PATH=
TIKTOK_ACCESS_TOKEN=
# Meta App Secret — enables WhatsApp webhook HMAC signature verification. If UNSET, webhook FAILS CLOSED: requests carrying x-hub-signature-256 are rejected 401; unsigned requests accepted (dev mode).
FB_APP_SECRET=
# Token Meta sends during webhook verification handshake (must match app config)
WEBHOOK_VERIFY_TOKEN=

# LinkedIn Ads (optional)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pinterest Ads (optional)
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_ID=

# Snapchat Ads (optional)
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_REFRESH_TOKEN=

# Twitter/X Ads (optional)
TWITTER_ACCESS_TOKEN=
TWITTER_ACCOUNT_ID=

# Microsoft/Bing Ads (optional)
MICROSOFT_ACCESS_TOKEN=
MICROSOFT_DEVELOPER_TOKEN=
MICROSOFT_CUSTOMER_ID=

# Reddit Ads (optional)
REDDIT_ACCESS_TOKEN=
REDDIT_ACCOUNT_ID=

# Spotify Ads (optional)
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_ACCOUNT_ID=

# WhatsApp Business Ads (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Amazon Ads (optional)
AMAZON_ACCESS_TOKEN=
AMAZON_PROFILE_ID=

# Apple Search Ads (optional)
APPLE_ACCESS_TOKEN=
APPLE_ORG_ID=

# Criteo Ads (optional)
CRITEO_ACCESS_TOKEN=
CRITEO_ADVERTISER_ID=

# Taboola Ads (optional)
TABOOLA_ACCESS_TOKEN=
TABOOLA_ACCOUNT_ID=

# The Trade Desk (optional)
THETRADEDESK_ACCESS_TOKEN=
THETRADEDESK_ADVERTISER_ID=

# Yandex Direct (optional)
YANDEX_ACCESS_TOKEN=
YANDEX_CLIENT_ID=

# Baidu Ads (optional)
BAIDU_ACCESS_TOKEN=
BAIDU_ACCOUNT_ID=

# KakaoTalk Ads (optional)
KAKAO_ACCESS_TOKEN=
KAKAO_AD_ACCOUNT_ID=

# LINE Ads (optional)
LINE_ACCESS_TOKEN=
LINE_AD_ACCOUNT_ID=
# External Services
# ── 1ai-Payment API ───────────────────────────────────
1AI_PAYMENT_URL=http://localhost:3100/api/payments
1AI_PAYMENT_API_KEY=                  # API key from 1ai-payment service

BK_HUB_URL=http://localhost:9099
COMPETITOR_URLS=
TRENDING_EXTERNAL_SOURCE=mock
EXTERNAL_TRENDING_API_URL=https://api.example.com/trending
EXTERNAL_TRENDING_API_KEY=
TRENDING_CACHE_TTL=3600

# Competitor Intelligence (optional)
SIMILARWEB_API_KEY=

# AdSpire Legacy Integration (optional)
AD_SPIRE_API_KEY=
AD_SPIRE_API_URL=https://api.adspire.io/v1

# Adspirer MCP Integration (optional)
ADSPIRER_CLIENT_ID=
ADSPIRER_REDIRECT_URI=http://localhost:5173/api/adspirer/auth/callback
# Nango OAuth Management (optional)
NANGO_SECRET_KEY=

# Rate Limiting (public endpoints)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Meta AI (MAIBA)
META_AI_ENDPOINT=https://adsmanager.facebook.com/api/graphql/
META_AI_DOC_ID=26667472482923907
META_AI_FRIENDLY_NAME=MAIBAGraphQLSendMessageV2QueryMutation

# Ads Library AI
ADS_LIBRARY_AI_ENDPOINT=https://www.facebook.com/api/graphql/
ADS_LIBRARY_AI_DOC_ID=29650582277919185

# Hermes Bot Proxy
HERMES_BOT_URL=http://127.0.0.1:8443

# Meta Ad Library URLs
META_AD_LIBRARY_URL=https://www.facebook.com/ads/library/
META_AD_LIBRARY_API_URL=https://www.facebook.com/ads/library/async/

# Meta API Version
META_API_VERSION=v22.0

# Service Intervals (ms)
CLEANUP_INITIAL_DELAY_MS=60000
OPTIMIZER_INITIAL_DELAY_MS=30000
DAILY_REPORTER_INTERVAL_MS=300000
WEBHOOK_PROCESSOR_INTERVAL_MS=60000
AUTONOMOUS_AGENT_INTERVAL_MS=900000
REALTIME_POLL_INTERVAL_MS=30000
AI_AGENT_SCHEDULER_INTERVAL_MS=300000
CACHE_CLEANUP_INTERVAL_MS=300000

# Content Bridge
CONTENT_BRIDGE_URL=http://localhost:3000
CONTENT_BRIDGE_API_KEY=
SOCIAL_BRIDGE_URL=http://localhost:8200
SOCIAL_WEBHOOK_SECRET=


# ── Telegram Bot ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # Bot token from @BotFather
TELEGRAM_WEBHOOK_HOST=adforge.aitradepulse.com  # Public host for the Telegram webhook (do NOT use container HOSTNAME)
TELEGRAM_CHAT_ID=             # Chat ID for admin alerts (optional — logs only if missing)

# ── Scheduler: Bid Satpam ─────────────────────────────
BID_SATPAM_MIN=130            # Minimum bid amount (IDR)
BID_SATPAM_MAX=150            # Maximum bid amount (IDR)
BID_SATPAM_TARGET=140         # Target bid amount when out of range
EVALUATION_DAYS=3             # Days before campaign evaluation

# ── Optimization Thresholds ───────────────────────────
PLATFORM_TAX_RATE=0.06        # Platform tax rate (6%)
ROAS_SCALE_UP=2.0             # ROAS threshold for scale-up
ROAS_PROFITABLE=1.0           # ROAS threshold for profitable
ROAS_STOP_LOSS=0.7            # ROAS threshold for stop-loss
CTR_MIN=1.0                   # Minimum CTR (%)
CTR_SCALE=2.0                 # CTR threshold for scaling
CPC_MAX=200                   # Maximum CPC (IDR)
CPC_SCALE=120                 # CPC threshold for scaling
STOPLOSS_ROAS_DROP=0.30       # ROAS drop % to trigger stoploss
STOPLOSS_BUDGET_REDUCTION=0.50 # Budget reduction factor on stoploss
STOPLOSS_MAX_DROPS=3          # Max consecutive drops before kill
BUDGET_LADDER=200000,500000,1000000,2000000,5000000,10000000

# ── Dayparting ────────────────────────────────────────
DAYPARTING_PEAK_HOURS=9,10,11,18,19,20,21
DAYPARTING_OFFPEAK_HOURS=0,1,2,3,4,5,6
DAYPARTING_PEAK_FACTOR=1.3    # Budget multiplier during peak hours
DAYPARTING_OFFPEAK_FACTOR=0.5 # Budget multiplier during off-peak
DAYPARTING_TIMEZONE=Asia/Jakarta

# ── Creative Rotation ─────────────────────────────────
CREATIVE_ROTATION_MEDIUM_DAYS=7    # Days before medium-fatigue rotation
CREATIVE_ROTATION_PREVENTIVE_DAYS=14 # Days before preventive rotation

# ── Security ──────────────────────────────────────────
CSRF_SECRET=                  # Secret for CSRF token generation (optional)

# ── Monitoring (optional) ─────────────────────────────
SENTRY_DSN=                  # Sentry error tracking DSN (optional)

# ── Capital Pool / Treasury (1ai-hub) ────────────────
TREASURY_HUB_URL=http://localhost:8000  # 1ai-hub base URL; if unset, treasury recording is skipped
TREASURY_HUB_TOKEN=                     # Optional bearer token for hub auth

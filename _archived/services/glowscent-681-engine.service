[Unit]
Description=Glowscent 681 Auto-Engine — Shopee Affiliate Meta Ads Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=/home/openclaw/projects/1ai-ads
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/openclaw/projects/1ai-ads/scripts/glowscent_681_engine.py --monitor
Restart=always
RestartSec=30
StandardOutput=append:/home/openclaw/projects/1ai-ads/logs/glowscent_681_service.log
StandardError=append:/home/openclaw/projects/1ai-ads/logs/glowscent_681_service.log

[Install]
WantedBy=multi-user.target
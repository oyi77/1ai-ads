<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> — AdForge</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>

<div class="app-shell">
    <!-- SIDEBAR -->
    <aside class="app-sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">A</div>
            <div class="sidebar-brand-text">Ad<span>Forge</span></div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-section">Main</div>
            <a href="/app" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? ' active' : '' %>">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="/campaigns" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'campaigns' ? ' active' : '' %>">
                <i class="bi bi-megaphone"></i> Campaigns
            </a>
            <a href="/automation" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'automation' ? ' active' : '' %>">
                <i class="bi bi-lightning-charge"></i> Automation
            </a>

            <div class="sidebar-section">Creative</div>
            <a href="/creative/library" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'creative-library' ? ' active' : '' %>">
                <i class="bi bi-palette"></i> Library
            </a>
            <a href="/creative/fatigue" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'creative-fatigue' ? ' active' : '' %>">
                <i class="bi bi-exclamation-triangle"></i> Fatigue
            </a>
            <a href="/creative/scoring" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'creative-scoring' ? ' active' : '' %>">
                <i class="bi bi-star"></i> Scoring
            </a>

            <div class="sidebar-section">Testing</div>
            <a href="/testing/ab-tests" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'ab-tests' ? ' active' : '' %>">
                <i class="bi bi-beaker"></i> A/B Tests
            </a>

            <div class="sidebar-section">Reporting</div>
            <a href="/reporting/unified" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'unified-reporting' ? ' active' : '' %>">
                <i class="bi bi-graph-up-arrow"></i> Unified
            </a>
            <a href="/reporting/widgets" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'dashboard-widgets' ? ' active' : '' %>">
                <i class="bi bi-grid"></i> Widgets
            </a>

            <div class="sidebar-section">Account</div>
            <a href="/settings" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'settings' ? ' active' : '' %>">
                <i class="bi bi-gear"></i> Settings
            </a>
        </nav>

        <div class="sidebar-footer">
            <div style="display:flex;align-items:center;gap:6px;justify-content:center">
                <span class="live-dot"></span> v5.0 &middot; <%= typeof username !== 'undefined' ? username : 'AdForge' %>
            </div>
        </div>
    </aside>

    <!-- MAIN AREA -->
    <div class="app-main">
        <!-- TOP BAR -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle" onclick="document.getElementById('sidebar').classList.toggle('open')">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    <div class="topbar-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></div>
                    <div class="topbar-breadcrumb">
                        <a href="/app">AdForge</a> /
                        <%= typeof breadcrumb !== 'undefined' ? breadcrumb : 'Overview' %>
                    </div>
                </div>
            </div>
            <div class="topbar-right">
                <span style="font-size:0.73rem;color:var(--text-tertiary)"><%= typeof username !== 'undefined' ? username : '' %></span>
                <a href="/auth/logout" class="btn btn-ghost btn-sm" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </header>

        <!-- CONTENT -->
        <div class="main-content">
            <%- body %>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
window.showToast = function(title, msg, type, dur) {
    type = type || 'info'; dur = dur || 4000;
    var icons = {success:'\u2705',error:'\u274C',warning:'\u26A0\uFE0F',info:'\u2139\uFE0F'};
    var t = document.createElement('div');
    t.className = 'toast ' + type;
    t.innerHTML = '<span class="toast-icon">'+(icons[type]||icons.info)+'</span><div class="toast-body"><div class="toast-title">'+title+'</div><div class="toast-msg">'+msg+'</div></div>';
    if(dur>0) setTimeout(function(){t.style.opacity='0';t.style.transform='translateX(20px)';t.style.transition='all 0.2s';setTimeout(function(){t.remove()},200)},dur);
    t.addEventListener('click',function(){t.remove()});
    var c = document.getElementById('toastContainer');
    while(c.children.length>=5) c.firstChild.remove();
    c.appendChild(t);
};
</script>

<%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
</html>

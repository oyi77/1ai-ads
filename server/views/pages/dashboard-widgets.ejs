<% const title = 'Dashboard Builder'; const pageTitle = 'Dashboard Builder'; const breadcrumb = 'Reporting > Widgets'; const activePage = 'dashboard-widgets'; %>
<%- include('../layouts/base', { title, pageTitle, breadcrumb, activePage, username: typeof username !== 'undefined' ? username : '', body: '' }) %>
<script>
document.querySelector('.main-content').innerHTML = `
<div class="page-header">
    <div><h1>Dashboard Builder</h1><p>Customize your dashboard with widgets</p></div>
</div>
<div id="widgetGrid" class="metrics-grid"></div>`;

fetch('/api/dashboard-widgets').then(function(r){return r.json()}).then(function(resp){
    var widgets = (resp && resp.data) || resp || [];
    var grid = document.getElementById('widgetGrid');
    if (!widgets.length) {
        grid.innerHTML = '<div style="padding:40px;text-align:center;color:var(--text-tertiary)"><i class="bi bi-bar-chart" style="font-size:2rem"></i><p style="margin-top:8px">No widgets configured. Use the API to add widgets.</p></div>';
        return;
    }
    function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
    grid.innerHTML = widgets.map(function(w){
        var icon = w.type === 'chart' ? 'bi-bar-chart' : w.type === 'metric' ? 'bi-speedometer' : 'bi-grid';
        return '<div class="metric-card" style="cursor:pointer;text-align:center"><i class="bi '+icon+'" style="font-size:1.5rem;color:var(--accent)"></i><div style="font-size:0.8rem;font-weight:600;margin-top:6px">'+esc(w.name)+'</div><div style="font-size:0.7rem;color:var(--text-tertiary)">'+esc(w.description||'')+'</div></div>';
    }).join('');
});
</script>
